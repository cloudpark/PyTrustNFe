<tipos:Rps xmlns:tipos="http://www.ginfes.com.br/tipos_v03.xsd">
    <tipos:InfRps Id="rps{{ numero }}">
        <tipos:IdentificacaoRps>
            <tipos:Numero>{{ numero }}</tipos:Numero>
            <tipos:Serie>{{ serie }}</tipos:Serie>
            <tipos:Tipo>{{ tipo_rps }}</tipos:Tipo>
        </tipos:IdentificacaoRps>
        <tipos:DataEmissao>{{ data_emissao }}</tipos:DataEmissao>
        <tipos:NaturezaOperacao>1</tipos:NaturezaOperacao>
        <tipos:OptanteSimplesNacional>{{ optante_simples }}</tipos:OptanteSimplesNacional>
        <tipos:IncentivadorCultural>{{ incentivador_cultural }}</tipos:IncentivadorCultural>
        <tipos:Status>{{ status }}</tipos:Status>
        <tipos:Servico>
            <tipos:Valores>
                <tipos:ValorServicos>{{ valor_servico }}</tipos:ValorServicos>
                <tipos:IssRetido>{{ iss_retido }}</tipos:IssRetido>
                <tipos:ValorIss>{{ valor_iss }}</tipos:ValorIss>
                <tipos:ValorIssRetido>{{ valor_iss_retido }}</tipos:ValorIssRetido>
                <tipos:BaseCalculo>{{ base_calculo }}</tipos:BaseCalculo>
                <tipos:Aliquota>{{ aliquota_issqn }}</tipos:Aliquota>
                <tipos:ValorLiquidoNfse>{{ valor_liquido_nfse }}</tipos:ValorLiquidoNfse>
            </tipos:Valores>
            <tipos:ItemListaServico>{{ codigo_servico }}</tipos:ItemListaServico>
            <tipos:CodigoTributacaoMunicipio>{{ codigo_tributacao_municipio }}</tipos:CodigoTributacaoMunicipio>
            <tipos:Discriminacao>{{descricao}}</tipos:Discriminacao>
            <tipos:CodigoMunicipio>{{ codigo_municipio }}</tipos:CodigoMunicipio>
        </tipos:Servico>
        <tipos:Prestador>
            <tipos:Cnpj>{{ prestador.cnpj }}</tipos:Cnpj>
            <tipos:InscricaoMunicipal>{{ prestador.inscricao_municipal }}</tipos:InscricaoMunicipal>
        </tipos:Prestador>
        <tipos:Tomador>
            <tipos:IdentificacaoTomador>
                <tipos:CpfCnpj>
                    {% if tomador.cnpj_cpf|length == 14  %}
                    <tipos:Cnpj>{{ tomador.cnpj_cpf }}</tipos:Cnpj>
                    {% endif %}
                    {% if tomador.cnpj_cpf|length == 11  %}
                    <tipos:Cpf>{{ tomador.cnpj_cpf }}</tipos:Cpf>
                    {% endif %}
                </tipos:CpfCnpj>
            </tipos:IdentificacaoTomador>
            <tipos:RazaoSocial>{{ tomador.razao_social }}</tipos:RazaoSocial>
        </tipos:Tomador>
    </tipos:InfRps>
</tipos:Rps>
