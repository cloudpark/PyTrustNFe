<EnviarLoteRpsEnvio xmlns="http://www.abrasf.org.br/nfse.xsd">
    <LoteRps Id="R1" versao="2.02">
        <NumeroLote>{{ nfse.numero_lote }}</NumeroLote>
        <CpfCnpj>
            <Cnpj>{{ nfse.cnpj_prestador }}</Cnpj>
        </CpfCnpj>
        <QuantidadeRps>{{ nfse.lista_rps|length }}</QuantidadeRps>
        <ListaRps>{% for rps in nfse.lista_rps -%}rps_{{rps.numero}}_rps{% endfor %}</ListaRps>
    </LoteRps>
</EnviarLoteRpsEnvio>
